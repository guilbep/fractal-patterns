{
  "name": "fractal-patterns",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "logo": "node scripts/make-logo.ts",
    "palettes": "node scripts/make-palettes.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "lint": "oxlint --deny-warnings src scripts",
    "format": "oxfmt src scripts vite.config.ts tsconfig.json package.json .github",
    "format:check": "oxfmt --check src scripts vite.config.ts tsconfig.json package.json .github",
    "e2e": "playwright test"
  },
  "dependencies": {
    "apca-w3": "^0.1.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "^6.0.0",
    "vite": "^8.2.2",
    "vue": "^3.5.22",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">=24"
  }
}
